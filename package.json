{
  "name": "collage-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "Local-first photo collages for Web, Android, iOS and Linux.",
  "license": "MIT",
  "engines": { "bun": ">=1.4.2", "node": ">=22" },
  "scripts": {
    "dev": "bun scripts/license-codecs.mjs build && vite --host 0.0.0.0",
    "dev:api": "bun --watch server/index.ts",
    "build": "bun scripts/license-codecs.mjs build && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "bun server/index.ts",
    "test": "vitest run",
    "license:codecs": "bun scripts/license-codecs.mjs build",
    "license:native": "bun scripts/license-native.mjs",
    "license:release": "bun scripts/license-codecs.mjs release",
    "build:native": "COLLAGE_NATIVE=1 bun run build --base=/",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "native:android:init": "tauri android init",
    "native:android:dev": "tauri android dev",
    "native:android:build": "tauri android build",
    "native:ios:init": "tauri ios init",
    "native:ios:dev": "tauri ios dev",
    "native:ios:build": "tauri ios build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/playfair-display": "^5.2.8",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify/utils": "^3.1.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-opener": "2.7.1",
    "@use-gesture/vanilla": "^10.3.1",
    "@vueuse/core": "^14.0.0",
    "dexie": "^4.2.1",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "hono": "^4.12.8",
    "konva": "^10.0.8",
    "lucide-vue-next": "^0.577.0",
    "mediabunny": "1.61.3",
    "pica": "^9.0.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.0",
    "smartcrop": "2.0.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.43",
    "vue-color": "3.3.3",
    "vue-konva": "^4.0.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^24.10.13",
    "@types/pica": "^9.0.5",
    "@types/sortablejs": "^1.15.9",
    "@types/tinycolor2": "1.4.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.6"
  }
}
